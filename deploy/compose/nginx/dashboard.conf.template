upstream nextmqtt_dashboard {
    # Keep a browser on one node so its dashboard token and WebSocket stay valid.
    ip_hash;

    server node-a:8080;
    server node-b:8080;
    server node-c:8080;
}

server {
    listen 8443 ssl;
    http2 on;
    server_name _;

    ssl_certificate ${NEXTMQTT_DASHBOARD_CERT};
    ssl_certificate_key ${NEXTMQTT_DASHBOARD_KEY};

    client_max_body_size 8m;

    # MQTT over WebSocket, used by the dashboard debugger.
    location /mqtt {
        proxy_pass http://nextmqtt_dashboard;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
    }

    location / {
        proxy_pass http://nextmqtt_dashboard;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
    }
}
