    <AssemblyName>NextMqtt.Broker</AssemblyName>
    <Description>NextMQTT broker engine: sessions, routing, retained messages, auth and clustering.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NextMqtt.Core\NextMqtt.Core.csproj" />
