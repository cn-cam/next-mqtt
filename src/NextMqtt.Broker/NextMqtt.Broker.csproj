<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>NextMqtt.Broker</RootNamespace>
    <AssemblyName>NextMqtt.Broker</AssemblyName>
    <Description>NextMQTT broker engine: sessions, routing, retained messages, auth and clustering.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NextMqtt.Core\NextMqtt.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- Runtime integrations approved by ADR 0007 (Kafka) and ADR 0008 (RabbitMQ). -->
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="RabbitMQ.Client" />
  </ItemGroup>
</Project>
